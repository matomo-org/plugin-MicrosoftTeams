parameters:
    level: 5
    phpVersion: 80100
    tmpDir: /tmp/phpstan/MicrosoftTeams/main
    paths:
        - .
    ignoreErrors:
        # the version guard is constant-folded against core's version: always true on 6.1.0 and later,
        # always false on the minimum-required Matomo analysed by CI, so each leg reports only one of them
        - identifier: ternary.alwaysTrue
          path: MicrosoftTeams.php
          count: 1
          reportUnmatched: false
        - identifier: ternary.alwaysFalse
          path: MicrosoftTeams.php
          count: 1
          reportUnmatched: false
    excludePaths:
        - tests/*
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        # ../../ does not actually seem to give us anything
        # that ../plugins/ does not, but including it for
        # completeness.  It does not seem to slow down performance.
        - .
